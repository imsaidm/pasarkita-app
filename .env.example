# Salin ke .env lalu isi. Jangan pernah commit .env yang sudah terisi.
# Di VPS, nilai sebenarnya dibaca dari /home/master123/.config/pasarkita/secrets.env

# Kunci penanda tangan sesi. Minimal 32 karakter.
# Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# PostgreSQL
DATABASE_URL=postgres://pasarkita:GANTI@127.0.0.1:5434/pasarkita

# Port tiap aplikasi. 3106 dan 3116 sudah dipakai layanan lama di VPS.
PORT_STORE=3107
PORT_POS=3108
PORT_DASHBOARD=3109

# Alamat publik, dipakai untuk membentuk tautan antar aplikasi
PUBLIC_URL_WEB=https://pasarkita.net
PUBLIC_URL_STORE=https://store.pasarkita.net
PUBLIC_URL_POS=https://pos.pasarkita.net
PUBLIC_URL_DASHBOARD=https://dashboard.pasarkita.net

# Mode demo. Matikan dengan false kalau tombol demo tidak ingin ditampilkan.
DEMO_ENABLED=true
